/runs/
/logs/
/outputs/
/referenced-chatgpt-conversation-this-is-an-2/
/upload-to-h100/

# External repositories and downloaded models; revisions are in dependencies.lock.json.
/deps/
/models/
/checkpoints/
/data/

# Python environments, caches and build output.
.python/
.venv*/
venv/
env/
.conda/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
