+    http_client.max_keepalive_connections="${AGL_HTTP_MAX_KEEPALIVE:-20}" \
+    http_client.keepalive_expiry="${AGL_HTTP_KEEPALIVE_EXPIRY:-5}" \
+    http_client.pool_timeout="${AGL_HTTP_POOL_TIMEOUT:-300}" \
     >"$SERVER_LOG" 2>&1 &
 
 for _ in $(seq 1 60); do
@@ -40,6 +57,8 @@ done
 
