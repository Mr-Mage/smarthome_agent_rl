@@ -4,11 +4,24 @@
 # Run GSM8K VERL training with Agent Lightning's local controller.
 set -euo pipefail
 
+# Keep the proxy model name consistent with the trainer model path.
+MODEL_NAME="${GSM8K_MODEL:-Qwen/Qwen2.5-1.5B-Instruct}"
+ARGS=("$@")
+for ((i=0; i<${#ARGS[@]}; i++)); do
+    if [[ "${ARGS[i]}" == "--model" && $((i+1)) -lt ${#ARGS[@]} ]]; then
+        MODEL_NAME="${ARGS[i+1]}"
+    elif [[ "${ARGS[i]}" == --model=* ]]; then
+        MODEL_NAME="${ARGS[i]#--model=}"
+    fi
+done
+
 AGL_SERVER_PORT=8181
 AGL_KEY=dummy
 LOG_SUFFIX="$(date +%Y%m%d-%H%M%S)-$$"
-SERVER_LOG="/tmp/agl-gsm8k-server-$LOG_SUFFIX.log"
-CONTROLLER_LOG="/tmp/agl-gsm8k-controller-$LOG_SUFFIX.log"
+LOG_DIR="${AGL_LOG_DIR:-/tmp}"
+mkdir -p "$LOG_DIR"
+SERVER_LOG="$LOG_DIR/agl-gsm8k-server-$LOG_SUFFIX.log"
+CONTROLLER_LOG="$LOG_DIR/agl-gsm8k-controller-$LOG_SUFFIX.log"
 
 cleanup() {
     pkill -f agl-server 2>/dev/null || true
